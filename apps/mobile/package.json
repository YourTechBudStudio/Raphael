{
  "name": "@raphael/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "pnpm editor:prepare && expo start --android",
    "build": "pnpm editor:prepare && expo export --platform all",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "editor:prepare": "pnpm --filter \"@raphael/content...\" build && node scripts/build-editor.mjs",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "ios": "pnpm editor:prepare && expo start --ios",
    "lint": "oxlint . --deny-warnings",
    "prebuild": "pnpm editor:prepare && expo prebuild",
    "release:android": "pnpm editor:prepare && expo run:android --variant release",
    "release:ios": "pnpm editor:prepare && expo run:ios --configuration Release",
    "start": "pnpm editor:prepare && expo start",
    "test": "pnpm editor:prepare && node --test \"src/**/*.test.mjs\" \"tests/*.test.mjs\"",
    "typecheck": "pnpm editor:prepare && tsc --noEmit && tsc --noEmit --project src/modules/editor/webview/tsconfig.json",
    "web": "pnpm editor:prepare && expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/sora": "0.4.2",
    "@expo-google-fonts/source-sans-3": "0.4.1",
    "@raphael/client": "workspace:*",
    "@raphael/content": "workspace:*",
    "@raphael/contracts": "workspace:*",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "5.102.8",
    "@tiptap/core": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/pm": "catalog:",
    "clsx": "2.1.1",
    "effect": "catalog:",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-crypto": "^57.0.3",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "^57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "1.41.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.6.0",
    "uniwind": "1.12.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@raphael/backend": "workspace:*",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.2",
    "@yourtechbudstudio/raphael-typescript-config": "workspace:*",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  }
}
