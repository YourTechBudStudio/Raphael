{
  "name": "@raphael/backend",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "db:generate": "drizzle-kit generate",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "measure": "node bench/responsiveness.ts",
    "test": "node --test \"src/**/*.test.ts\" \"tests/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@raphael/content": "workspace:*",
    "@raphael/contracts": "workspace:*",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "express": "5.2.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@yourtechbudstudio/raphael-typescript-config": "workspace:*",
    "drizzle-kit": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
