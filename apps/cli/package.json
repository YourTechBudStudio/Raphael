{
  "name": "@raphael/cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "raphael": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "node --test \"src/**/*.test.ts\" \"tests/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@raphael/backend": "workspace:*",
    "@raphael/client": "workspace:*",
    "@raphael/contracts": "workspace:*",
    "@raphael/fs-trust": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yourtechbudstudio/raphael-typescript-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
