{
  "ignorePatterns": [
    "node_modules",
    "dist",
    "out",
    "build",
    "release",
    ".expo",
    ".next",
    ".turbo",
    "coverage",
    "**/tests/fixtures/**",
    "**/drizzle/**",
    ".agents",
    ".pi"
  ],
  "semi": true,
  "singleQuote": true,
  "sortImports": {
    "internalPattern": ["@yourtechbudstudio/raphael-"]
  },
  "sortPackageJson": {
    "sortScripts": true
  }
}
